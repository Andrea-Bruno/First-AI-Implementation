Dim m_NeroNazionalit‡ As String

'Dichiarazioni di eventi:
Event Click() 'MappingInfo=UserControl,UserControl,-1,Click
Attribute Click.VB_Description = "Viene generato quando si preme e quindi si rilascia un pulsante del mouse su un oggetto."
Event DblClick() 'MappingInfo=UserControl,UserControl,-1,DblClick
Attribute DblClick.VB_Description = "Viene generato quando si preme e si rilascia due volte in rapida successione un pulsante del mouse su un oggetto."
Event KeyDown(KeyCode As Integer, Shift As Integer) 'MappingInfo=UserControl,UserControl,-1,KeyDown
Attribute KeyDown.VB_Description = "Viene generato quando si preme un tasto mentre lo stato attivo si trova su un oggetto."
Event KeyPress(KeyAscii As Integer) 'MappingInfo=UserControl,UserControl,-1,KeyPress
Attribute KeyPress.VB_Description = "Viene generato quando si preme e si rilascia un tasto ANSI."
Event KeyUp(KeyCode As Integer, Shift As Integer) 'MappingInfo=UserControl,UserControl,-1,KeyUp
Attribute KeyUp.VB_Description = "Viene generato quando si rilascia un tasto mentre lo stato attivo si trova su un oggetto."
Event MouseDown(Button As Integer, Shift As Integer, x As Single, Y As Single) 'MappingInfo=UserControl,UserControl,-1,MouseDown
Attribute MouseDown.VB_Description = "Viene generato quando si preme il pulsante del mouse mentre lo stato attivo si trova su un oggetto."
Event MouseMove(Button As Integer, Shift As Integer, x As Single, Y As Single) 'MappingInfo=UserControl,UserControl,-1,MouseMove
Attribute MouseMove.VB_Description = "Viene generato quando si sposta il mouse."
Event MouseUp(Button As Integer, Shift As Integer, x As Single, Y As Single) 'MappingInfo=UserControl,UserControl,-1,MouseUp
Attribute MouseUp.VB_Description = "Viene generato quando si rilascia il pulsante del mouse mentre lo stato attivo si trova su un oggetto."
Event PezzoPosizionato(pezzo As pezzo, Provenienza As IndexCasa, Destinazione As IndexCasa)
Event CambiatoMossaAttuale(MossaAttuale As Integer)
Event Promozione(Colore As Colore, PezzoScelto As Genere)

Public Property Get Enabled() As Boolean
Attribute Enabled.VB_Description = "Restituisce o imposta un valore che determina se un oggetto Ë in grado di rispondere agli eventi generati dall'utente."
    Enabled = UserControl.Enabled
End Property

Public Property Let Enabled(ByVal New_Enabled As Boolean)
    UserControl.Enabled() = New_Enabled
    PropertyChanged "Enabled"
End Property
Public Property Get BorderStyle() As Integer
Attribute BorderStyle.VB_Description = "Restituisce o imposta lo stile del bordo di un oggetto."
    BorderStyle = UserControl.BorderStyle
End Property

Public Property Let BorderStyle(ByVal New_BorderStyle As Integer)
    UserControl.BorderStyle() = New_BorderStyle
    PropertyChanged "BorderStyle"
End Property
Public Sub Refresh()
Attribute Refresh.VB_Description = "Ridisegna completamente un oggetto."
    UserControl.Refresh
End Sub

Private Sub Casa_Click(Index As Integer)
  Dim RiferimentoCasa As IndexCasa
  Select Case m_Editabilit‡
    Case NonEditabile
      Exit Sub
    Case Editabile
      SelezionaIconaDrag Casa(Index).Figura, Index
      RiferimentoCasa = Index
      ImpostaCasaSelezionata RiferimentoCasa
      Casa(Index).Drag
    Case BiancoMossePossibili
      If PS.ColorePezzo(Casa(Index).Figura) = Bianco Then
        SelezionaIconaDrag Casa(Index).Figura, Index
        RiferimentoCasa = Index
        ImpostaCasaSelezionata RiferimentoCasa
        Casa(Index).Drag
      End If
    Case NeroMossePossibili
      If PS.ColorePezzo(Casa(Index).Figura) = Nero Then
        SelezionaIconaDrag Casa(Index).Figura, Index
        RiferimentoCasa = Index
        ImpostaCasaSelezionata RiferimentoCasa
        Casa(Index).Drag
      End If
  End Select
  DeselezionaTutto
  Casa(Index).Selezionato = True
End Sub
Private Sub Casa_Change(Index As Integer)
    Dim CoCa As CoordinateCasa
    Dim pz As pezzo
    CoCa = SV.IndividuaCoordinateCasa(Index)
    pz = Casa(Index).Figura
    m_DisposizioneScacchiera(CoCa.x, CoCa.Y) = pz
    AggiornaDisposizionePezzi
End Sub
Public Function Scacco(Colore As Colore) As Boolean
  Dim Avversario As Colore
  Dim x As Colonna, Y As Riga
  Select Case Colore
    Case Bianco
      x = PosizioneReBianco.x
      Y = PosizioneReBianco.Y
      Avversario = Nero
    Case Nero
      x = PosizioneReNero.x
      Y = PosizioneReNero.Y
      Avversario = Bianco
    Case Else
      Exit Function
  End Select
  Scacco = Elaborazione.InPresa(x, Y, Avversario, m_DisposizioneScacchiera)
End Function
Private Sub Casa_DragDrop(Index As Integer, Source As Control, x As Single, Y As Single)
  If TypeOf Source Is Casa Then
    Dim IdxProv As IndexCasa, IdxDest As IndexCasa
    IdxProv = Source.Index
    IdxDest = Index
    Select Case m_Editabilit‡
      Case Editabile
        Muovi IdxProv, IdxDest
        Exit Sub
      Case BiancoMossePossibili, NeroMossePossibili
          Dim Turno As Colore
          If Editabilit‡ = BiancoMossePossibili Then
            Turno = Bianco
          Else
            Turno = Nero
          End If
          Dim q As Integer
          Dim Mosse() As Variant
          Dim InScacco As Integer
          InScacco = Scacco(Turno)
          q = Elaborazione.MossePossibili(SV.IndividuaXCasa(IdxProv), SV.IndividuaYCasa(IdxProv), m_DisposizioneScacchiera, Mosse, m_XEnPassant, m_BiancoArroccoPossibile, m_NeroArroccoPossibile, PosizioneReBianco, PosizioneReNero, InScacco)
          If q <> 0 Then
            Dim N As Integer
            For N = 1 To q
              If Mosse(N).x = SV.IndividuaXCasa(IdxDest) And Mosse(N).Y = SV.IndividuaYCasa(IdxDest) Then
                Muovi IdxProv, IdxDest
                Exit Sub
              End If
            Next
            'il pezzo non Ë stato mosso correttamente
            MsgBox Messaggio3, vbInformation
          Else
            'il pezzo non si puÚ muovere
            MsgBox Messaggio4, vbInformation
          End If
     End Select
  End If
End Sub
Public Sub Muovi(Provenienza As IndexCasa, Destinazione As IndexCasa, Optional Promosso As Genere = Nessun_Genere, Optional Commento As String)
  Dim Respose As Variant
  If Provenienza = Destinazione Then
    Exit Sub
  End If
  If m_MossaAttuale < m_Quantit‡MosseTraccia Then
    Respose = MsgBox(Messaggio1, vbYesNo)
    If Respose = 7 Then
      Exit Sub
    End If
  End If
  m_Quantit‡MosseTraccia = m_MossaAttuale + 1
  m_MossaAttuale = m_Quantit‡MosseTraccia
  ReDim Preserve m_Traccia(m_MossaAttuale)
  m_Traccia(m_MossaAttuale).Provenienza.pezzo = Casa(Provenienza).Figura
  m_Traccia(m_MossaAttuale).Provenienza.Posizione = SV.IndividuaCoordinateCasa(Provenienza)
  m_Traccia(m_MossaAttuale).Destinazione.pezzo = Casa(Destinazione).Figura
  m_Traccia(m_MossaAttuale).Destinazione.Posizione = SV.IndividuaCoordinateCasa(Destinazione)
  MuoviSenzaTraccia Provenienza, Destinazione
  m_XEnPassant = NessunaColonna
  If Casa(Destinazione).Figura = Pedone_Bianco Then
    If SV.IndividuaYCasa(Provenienza) = Riga_2 Then
      If SV.IndividuaYCasa(Destinazione) = Riga_4 Then
        m_XEnPassant = SV.IndividuaXCasa(Destinazione)
      End If
    End If
  ElseIf Casa(Destinazione).Figura = Pedone_Nero Then
    If SV.IndividuaYCasa(Provenienza) = Riga_7 Then
      If SV.IndividuaYCasa(Destinazione) = Riga_5 Then
        m_XEnPassant = SV.IndividuaXCasa(Destinazione)
      End If
    End If
  End If
  PropertyChanged "XEnPassant"
  m_Traccia(m_MossaAttuale).BiancoArroccoPossibile = m_BiancoArroccoPossibile
  m_Traccia(m_MossaAttuale).NeroArroccoPossibile = m_NeroArroccoPossibile
  m_Traccia(m_MossaAttuale).XEnPassant = m_XEnPassant
  m_Traccia(m_MossaAttuale).Editabilit‡ = m_Editabilit‡
  m_Traccia(m_MossaAttuale).Nota = Commento
  m_Traccia(m_MossaAttuale).Collegamento = ""
  If m_AbilitaVisualizzazionePezzi = True Then
    RaiseEvent CambiatoMossaAttuale(m_MossaAttuale)
  End If
  If m_RegistraTempo = True Then
    If m_MossaAttuale = 1 Then
      PropertyChanged "EventoOra"
      'm_EventoData = Now
      m_EventoOra = Now
      m_Traccia(m_MossaAttuale).Tempo = 0
    Else
      m_Traccia(m_MossaAttuale).Tempo = Now - m_EventoOra - m_Traccia(m_MossaAttuale - 1).Tempo
    End If
  End If
  If m_Editabilit‡ = Editabile Then
    Casa(Provenienza).Selezionato = False
  End If
  Casa(Destinazione).Selezionato = True
  If Editabilit‡ = BiancoMossePossibili Then
    m_Editabilit‡ = NeroMossePossibili
  ElseIf Editabilit‡ = NeroMossePossibili Then
    m_Editabilit‡ = BiancoMossePossibili
  End If
  'Genera evento Promozione
  If Promosso = Nessun_Genere Then
    'L'evento Ë generato solo se non Ë ancora stato specificato quale Ë il pezzo promosso
    If Abs(Casa(Destinazione).Figura) = Pedone Then
      Dim R As Riga
      R = SV.IndividuaYCasa(Destinazione)
      If R = Riga_1 Then
       RaiseEvent Promozione(Nero, Promosso)
      ElseIf R = Riga_8 Then
        RaiseEvent Promozione(Bianco, Promosso)
      End If
    End If
  End If
  'Posiziona il pezzo promosso
  If Promosso <> Nessun_Genere Then
    ImpostaPezzoPromosso Promosso
  End If
  If m_AbilitaVisualizzazionePezzi = True Then
    RaiseEvent PezzoPosizionato(Casa(Destinazione).Figura, Provenienza, Destinazione)
  End If
End Sub
Private Sub MuoviSenzaTraccia(Provenienza As IndexCasa, Destinazione As IndexCasa)
  'esegui mossa presa en passant
  Dim idx As Integer
  'Verifica se si st‡ arroccando
  If Abs(Casa(Provenienza).Figura) = RE Then
    If Provenienza = E1 And Destinazione = G1 And ((m_BiancoArroccoPossibile And Destra) <> 0) Then
      'Il bianco arrocca a destra
      Casa(H1).Figura = Nessun_Pezzo
      Casa(F1).Figura = Torre_Bianco
      m_BiancoArroccoPossibile = 0
    End If
    If Provenienza = E1 And Destinazione = C1 And ((m_BiancoArroccoPossibile And Sinistra) <> 0) Then
      'Il bianco arrocca a sinistra
      Casa(A1).Figura = Nessun_Pezzo
      Casa(D1).Figura = Torre_Bianco
      m_BiancoArroccoPossibile = 0
    End If
    If Provenienza = E8 And Destinazione = G8 And ((m_NeroArroccoPossibile And Destra) <> 0) Then
      'Il nero arrocca a destra
      Casa(H8).Figura = Nessun_Pezzo
      Casa(F8).Figura = Torre_Nero
      m_NeroArroccoPossibile = 0
    End If
    If Provenienza = E8 And Destinazione = C8 And ((m_NeroArroccoPossibile And Sinistra) <> 0) Then
      'Il nero arrocca a sinistra
      Casa(A8).Figura = Nessun_Pezzo
      Casa(D8).Figura = Torre_Nero
      m_NeroArroccoPossibile = 0
    End If
    
    'Verifica se la mossa Ë un ritorno a prima di arroccare
    If Provenienza = G1 And Destinazione = E1 And Casa(Provenienza).Figura = Re_Bianco Then
      'Il bianco ritorna sull'arrocco a destra
      If Casa(F1).Figura = Torre_Bianco Then
        Casa(F1).Figura = Nessun_Pezzo
        Casa(H1).Figura = Torre_Bianco
      End If
    End If
    If Provenienza = C1 And Destinazione = E1 And Casa(Provenienza).Figura = Re_Bianco Then
      'Il bianco ritorna sull'arrocco a sinistra
      If Casa(D1).Figura = Torre_Bianco Then
        Casa(D1).Figura = Nessun_Pezzo
        Casa(A1).Figura = Torre_Bianco
      End If
    End If
    If Provenienza = G8 And Destinazione = E8 And Casa(Provenienza).Figura = Re_Nero Then
      'Il nero ritorna sull'arrocco a destra
      If Casa(F8).Figura = Torre_Nero Then
        Casa(F8).Figura = Nessun_Pezzo
        Casa(H8).Figura = Torre_Nero
      End If
    End If
    If Provenienza = C8 And Destinazione = E8 And Casa(Provenienza).Figura = Re_Nero Then
      'Il nero ritorna sull'arrocco a sinistra
      If Casa(D8).Figura = Torre_Nero Then
        Casa(D8).Figura = Nessun_Pezzo
        Casa(A8).Figura = Torre_Nero
      End If
    End If
  End If
  If Abs(Casa(Provenienza).Figura) = Torre Then
    'Si muove una torre che precluder‡ l'arrocco
    If Provenienza = A1 Then
      m_BiancoArroccoPossibile = m_BiancoArroccoPossibile And Not Sinistra
    End If
    If Provenienza = H1 Then
      m_BiancoArroccoPossibile = m_BiancoArroccoPossibile And Not Destra
    End If
    If Provenienza = A8 Then
      m_NeroArroccoPossibile = m_NeroArroccoPossibile And Not Sinistra
    End If
    If Provenienza = H8 Then
      m_NeroArroccoPossibile = m_NeroArroccoPossibile And Not Destra
    End If
  ElseIf Abs(Casa(Provenienza).Figura) = RE Then
    'Si muove il re e non sar‡ pi˘ possibile arroccare
    If Provenienza = E1 Then
      m_BiancoArroccoPossibile = Nessun_Lato
    ElseIf Provenienza = E8 Then
      m_NeroArroccoPossibile = Nessun_Lato
    End If
  End If
  If (m_XEnPassant = SV.IndividuaXCasa(Destinazione)) Or (m_XEnPassant = SV.IndividuaXCasa(Provenienza)) Then
    'se Ë il bianco a catturare en passant
    If Casa(Provenienza).Figura = Pedone_Bianco Then
      If Abs(SV.IndividuaXCasa(Provenienza) - SV.IndividuaXCasa(Destinazione)) = 1 Then
        'se la mossa Ë stata effettuata
        If SV.IndividuaYCasa(Provenienza) = Riga_5 Then
          If SV.IndividuaYCasa(Destinazione) = Riga_6 Then
            idx = SV.IndividuaIndexCasa(SV.IndividuaXCasa(Destinazione), SV.IndividuaYCasa(Provenienza))
            If Casa(idx).Figura = Pedone_Nero Then
              Casa(idx).Figura = Nessun_Pezzo
            End If
          End If
        'se si torna indietro di una mossa
        ElseIf SV.IndividuaYCasa(Provenienza) = Riga_6 Then
          If SV.IndividuaYCasa(Destinazione) = Riga_5 Then
            idx = SV.IndividuaIndexCasa(SV.IndividuaXCasa(Provenienza), SV.IndividuaYCasa(Destinazione))
            If Casa(idx).Figura = Nessun_Pezzo Then
              Casa(idx).Figura = Pedone_Nero
            End If
          End If
        End If
      End If
    End If
    'se Ë il nero a catturare en passant
    If Casa(Provenienza).Figura = Pedone_Nero Then
      If Abs(SV.IndividuaXCasa(Provenienza) - SV.IndividuaXCasa(Destinazione)) = 1 Then
        'se la mossa Ë stata effettuata
        If SV.IndividuaYCasa(Provenienza) = Riga_4 Then
          If SV.IndividuaYCasa(Destinazione) = Riga_3 Then
            idx = SV.IndividuaIndexCasa(SV.IndividuaXCasa(Destinazione), SV.IndividuaYCasa(Provenienza))
            If Casa(idx).Figura = Pedone_Bianco Then
              Casa(idx).Figura = Nessun_Pezzo
            End If
          End If
        'se si torna indietro di una mossa
        ElseIf SV.IndividuaYCasa(Provenienza) = Riga_3 Then
          If SV.IndividuaYCasa(Destinazione) = Riga_4 Then
            idx = SV.IndividuaIndexCasa(SV.IndividuaXCasa(Provenienza), SV.IndividuaYCasa(Destinazione))
            If Casa(idx).Figura = Nessun_Pezzo Then
              Casa(idx).Figura = Pedone_Bianco
            End If
          End If
        End If
      End If
    End If
  End If
  'elaborazione.EffettuaMossa IndividuaXCasa(Provenienza), IndividuaYCasa(Provenienza), IndividuaXCasa(Destinazione), IndividuaYCasa(Destinazione), m_DisposizioneScacchiera, m_XEnPassant, m_BiancoArroccoPossibile, m_NeroArroccoPossibile
  'Aggiorna
  Dim tmpCasa As pezzo
  tmpCasa = Casa(Provenienza).Figura
  Casa(Provenienza).Figura = Nessun_Pezzo
  Casa(Destinazione).Figura = tmpCasa
  If m_AbilitaVisualizzazionePezzi = True Then
    DeselezionaTutto
    Casa(Provenienza).Selezionato = True
    Casa(Destinazione).Selezionato = True
  End If
  SelezionatoProvenienza = Provenienza
  SelezionatoDestinazione = Destinazione
End Sub

