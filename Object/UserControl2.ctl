Public Property Get AbilitaVisualizzazionePezzi() As Boolean
Attribute AbilitaVisualizzazionePezzi.VB_Description = "Se impostato su False inibisce l'aggiornamento della scacchiera quando vengono posizionati i pezzi, in questo modo si velocizzano alcune operazioni."
Attribute AbilitaVisualizzazionePezzi.VB_ProcData.VB_Invoke_Property = ";Varie"
  AbilitaVisualizzazionePezzi = m_AbilitaVisualizzazionePezzi
End Property

Public Property Let AbilitaVisualizzazionePezzi(ByVal New_AbilitaVisualizzazionePezzi As Boolean)
  If New_AbilitaVisualizzazionePezzi <> m_AbilitaVisualizzazionePezzi Then
    m_AbilitaVisualizzazionePezzi = New_AbilitaVisualizzazionePezzi
    PropertyChanged "AbilitaVisualizzazionePezzi"
    Dim idx As Integer
    For idx = A1 To H8
      Casa(idx).AggiornaFigura = m_AbilitaVisualizzazionePezzi
    Next
    
  End If
  If New_AbilitaVisualizzazionePezzi = True Then
    If SelezionatoProvenienza <> NessunaCasa Then
      Casa(SelezionatoProvenienza).Selezionato = True
    End If
    If SelezionatoDestinazione <> NessunaCasa Then
      Casa(SelezionatoDestinazione).Selezionato = True
    End If
    AggiornaDisposizionePezzi
  End If
End Property

