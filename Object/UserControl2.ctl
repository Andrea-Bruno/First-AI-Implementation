Dim m_MossaAttuale As Integer
Dim m_Quantit‡MosseTraccia As Integer
Dim m_Quantit‡PezziBianchi As Integer
Dim m_Quantit‡PezziNeri As Integer
Dim m_Quantit‡Pezzi As Integer
Dim m_XEnPassant As Colonna
Dim m_NeroArroccoPossibile As Lato
Dim m_BiancoArroccoPossibile  As Lato
Dim m_AbilitaVisualizzazionePezzi As Boolean
Dim m_RegistraTempo As Boolean


