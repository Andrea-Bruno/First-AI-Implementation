Public Property Get XEnPassant() As Colonna
Attribute XEnPassant.VB_Description = "Imposta o restituisce la colonna in cui vi Ë un pedone che puÚ essere preso en passant."
Attribute XEnPassant.VB_ProcData.VB_Invoke_Property = ";Situazione"
    XEnPassant = m_XEnPassant
End Property
Public Property Let XEnPassant(New_XEnPassant As Colonna)
    If New_XEnPassant <> NessunaColonna Then
      If m_Editabilit‡ = BiancoMossePossibili Then
        If Casa(SV.IndividuaIndexCasa(New_XEnPassant, Riga_5)).Figura <> Pedone_Nero Then
          MsgBox Messaggio5, vbInformation
          Exit Property
        End If
      ElseIf m_Editabilit‡ = NeroMossePossibili Then
        If Casa(SV.IndividuaIndexCasa(New_XEnPassant, Riga_5)).Figura <> Pedone_Nero Then
          MsgBox Messaggio6, vbInformation
          Exit Property
        End If
      Else
        MsgBox Messaggio7, vbInformation
        Exit Property
      End If
    End If
    m_XEnPassant = New_XEnPassant
    m_Traccia(m_MossaAttuale).XEnPassant = m_XEnPassant
    PropertyChanged "XEnPassant"
End Property
