Public Property Get MossaAttuale() As Integer
Attribute MossaAttuale.VB_Description = "Variabile utile per muoversi liberamente all' interno della traccia delle mosse."
Attribute MossaAttuale.VB_ProcData.VB_Invoke_Property = ";Traccia"
    MossaAttuale = m_MossaAttuale
End Property
Public Property Let MossaAttuale(ByVal New_MossaAttuale As Integer)
    Dim N As Integer
    Dim Passo As Integer
    Dim AbVPz As Boolean
    AbVPz = AbilitaVisualizzazionePezzi
    DeselezionaTutto
    m_AbilitaVisualizzazionePezzi = False
    If New_MossaAttuale > m_Quantit‡MosseTraccia Or New_MossaAttuale < 0 Then
      MsgBox Messaggio2, vbInformation
      AbilitaVisualizzazionePezzi = AbVPz
      Exit Property
    End If
    If New_MossaAttuale < m_MossaAttuale Then
      Passo = -1
    ElseIf New_MossaAttuale > m_MossaAttuale Then
      Passo = 1
    ElseIf New_MossaAttuale = m_MossaAttuale Then
      AbilitaVisualizzazionePezzi = AbVPz
      Exit Property
    End If
    Dim Provenienza As IndexCasa, Destinazione As IndexCasa
    Dim Inizio As Integer
    Dim Fine As Integer
    If Passo = -1 Then
      Inizio = m_MossaAttuale: Fine = New_MossaAttuale + 1
    Else
      Inizio = m_MossaAttuale + 1: Fine = New_MossaAttuale
    End If
    For N = Inizio To Fine Step Passo
      Provenienza = SV.IndividuaIndexCasa(m_Traccia(N).Provenienza.Posizione.x, m_Traccia(N).Provenienza.Posizione.Y)
      Destinazione = SV.IndividuaIndexCasa(m_Traccia(N).Destinazione.Posizione.x, m_Traccia(N).Destinazione.Posizione.Y)
      m_XEnPassant = m_Traccia(N - 1).XEnPassant
      m_BiancoArroccoPossibile = m_Traccia(N - 1).BiancoArroccoPossibile
      m_NeroArroccoPossibile = m_Traccia(N - 1).NeroArroccoPossibile
      m_MossaAttuale = N
      If Passo = -1 Then
        If Traccia(N).Promozione <> Nessun_Genere Then
          If Casa(Destinazione).Figura > 0 Then
            Casa(Destinazione).Figura = Pedone_Bianco
          Else
            Casa(Destinazione).Figura = Pedone_Nero
          End If
        End If
        MuoviSenzaTraccia Destinazione, Provenienza
        Casa(Destinazione).Figura = m_Traccia(N).Destinazione.pezzo
      Else
        MuoviSenzaTraccia Provenienza, Destinazione
        Casa(Destinazione).Figura = m_Traccia(N).Provenienza.pezzo
        If Traccia(N).Promozione <> Nessun_Genere Then
          ImpostaPezzoPromosso (Traccia(N).Promozione)
        End If
      End If
    Next
    If Passo = -1 Then
      m_Editabilit‡ = m_Traccia(Inizio).Editabilit‡
    Else
      If m_Traccia(Fine).Editabilit‡ = BiancoMossePossibili Then
        m_Editabilit‡ = NeroMossePossibili
      ElseIf m_Traccia(Fine).Editabilit‡ = NeroMossePossibili Then
        m_Editabilit‡ = BiancoMossePossibili
      Else
        m_Editabilit‡ = m_Traccia(Fine).Editabilit‡
      End If
    End If
    m_XEnPassant = m_Traccia(New_MossaAttuale).XEnPassant
    PropertyChanged "XEnPassant"
    m_BiancoArroccoPossibile = m_Traccia(New_MossaAttuale).BiancoArroccoPossibile
    PropertyChanged "BiancoArroccoPossibile"
    m_NeroArroccoPossibile = m_Traccia(New_MossaAttuale).NeroArroccoPossibile
    PropertyChanged "NeroArroccoPossibile"
    AbilitaVisualizzazionePezzi = AbVPz
    m_MossaAttuale = New_MossaAttuale
    If m_AbilitaVisualizzazionePezzi = True Then
      RaiseEvent CambiatoMossaAttuale(m_MossaAttuale)
    End If
    PropertyChanged "MossaAttuale"
End Property
Public Property Get Quantit‡MosseTraccia() As Integer
Attribute Quantit‡MosseTraccia.VB_Description = "Count delle mosse contenute nella matrice Traccia"
Attribute Quantit‡MosseTraccia.VB_ProcData.VB_Invoke_Property = ";Traccia"
    Quantit‡MosseTraccia = m_Quantit‡MosseTraccia
End Property
Private Sub Aggiorna()
  'redisegna la scacchiera
  Dim N As Integer
  Dim WidthCasa, HeightCasa, WidthCoordinate, HeightCoordinate, ofx, ofy, minimo, x, Y, item
  For N = 0 To 63
    Casa(N).Visible = False
  Next
  If m_VisualizzaCoordinate = False Then
    For N = 0 To 7
      LabelX(N).Visible = False
      LabelY(N).Visible = False
    Next
    WidthCasa = Width / 8
    HeightCasa = Height / 8
    ofx = 0
    ofy = 0
  Else
    WidthCoordinate = Width / 16
    HeightCoordinate = Height / 16
    WidthCasa = (Width - WidthCoordinate) / 8
    HeightCasa = (Height - HeightCoordinate) / 8
    Select Case m_Orientamento
      Case 0
        ofx = WidthCoordinate
        ofy = -HeightCoordinate
        For N = 0 To 7
          LabelX(N).Width = WidthCasa
          LabelX(N).Height = HeightCoordinate
          LabelY(N).Width = WidthCoordinate
          LabelY(N).Height = HeightCasa
          LabelX(N).Left = WidthCoordinate + N * WidthCasa
          LabelX(N).Top = HeightCasa * 8
          LabelY(N).Left = 0
          LabelY(7 - N).Top = N * HeightCasa
        Next N
      Case 1
        ofx = 0
        ofy = 0
        For N = 0 To 7
          LabelX(N).Width = WidthCasa
          LabelX(N).Height = HeightCoordinate
          LabelY(N).Width = WidthCoordinate
          LabelY(N).Height = HeightCasa
          LabelX(7 - N).Left = N * WidthCasa
          LabelX(7 - N).Top = 0
          LabelY(N).Left = WidthCasa * 8
          LabelY(N).Top = HeightCoordinate + N * HeightCasa
        Next N
      Case 2
        ofx = WidthCoordinate
        ofy = 0
        For N = 0 To 7
          LabelY(N).Width = WidthCasa
          LabelY(N).Height = HeightCoordinate
          LabelX(N).Width = WidthCoordinate
          LabelX(N).Height = HeightCasa
          LabelY(N).Left = WidthCoordinate + N * WidthCasa
          LabelY(7 - N).Top = 0
          LabelX(N).Left = 0
          LabelX(N).Top = HeightCoordinate + N * HeightCasa
        Next N
      Case 3
        ofx = 0
        ofy = -HeightCoordinate
        For N = 0 To 7
          LabelY(N).Width = WidthCasa
          LabelY(N).Height = HeightCoordinate
          LabelX(N).Width = WidthCoordinate
          LabelX(N).Height = HeightCasa
          LabelY(7 - N).Left = N * WidthCasa
          LabelY(7 - N).Top = HeightCasa * 8
          LabelX(N).Left = WidthCasa * 8
          LabelX(7 - N).Top = N * HeightCasa
        Next N
    End Select
    If WidthCoordinate < HeightCoordinate Then
      minimo = WidthCoordinate
    Else
      minimo = HeightCoordinate
    End If
    'setta la dimenzione del carattere di LabelY() e di LabelX()
    For N = 0 To 7
      LabelY(N).FontSize = minimo / 30
      LabelX(N).FontSize = minimo / 30
    Next
   'visualizza le coordinate
    For N = 0 To 7
      LabelX(N).Visible = True
      LabelY(N).Visible = True
    Next N
  End If
  Select Case m_Orientamento
    Case 0
      For x = 0 To 7
      For Y = 0 To 7
        item = x + (Y * 8)
        Casa(item).Left = ofx + x * WidthCasa
        Casa(item).Width = WidthCasa
        Casa(item).Top = ofy + Height - ((1 + Y) * HeightCasa)
        Casa(item).Height = HeightCasa
      Next Y
      Next x
    Case 1
      For x = 0 To 7
      For Y = 0 To 7
        item = x + (Y * 8)
        item = 63 - item
        Casa(item).Left = ofx + x * WidthCasa
        Casa(item).Width = WidthCasa
        Casa(item).Top = ofy + Height - ((1 + Y) * HeightCasa)
        Casa(item).Height = HeightCasa
      Next Y
      Next x
    Case 2
      For x = 0 To 7
      For Y = 0 To 7
        item = (7 - Y) + (x * 8)
        Casa(item).Left = ofx + x * WidthCasa
        Casa(item).Width = WidthCasa
        Casa(item).Top = ofy + Height - ((1 + Y) * HeightCasa)
        Casa(item).Height = HeightCasa
      Next Y
      Next x
    Case 3
      For x = 0 To 7
      For Y = 0 To 7
        item = (7 - Y) + (x * 8)
        item = 63 - item
        Casa(item).Left = ofx + x * WidthCasa
        Casa(item).Width = WidthCasa
        Casa(item).Top = ofy + Height - ((1 + Y) * HeightCasa)
        Casa(item).Height = HeightCasa
      Next Y
      Next x
  End Select
  For N = 0 To 63
    Casa(N).Visible = True
  Next
End Sub

Private Sub SelezionaIconaDrag(ByVal Figura As pezzo, ByVal IdxCasa As Integer)
  Dim PathIcone As String
  PathIcone = Casa(0).PathFigure
  If Figura = Nessun_Pezzo Then
      Casa(IdxCasa).DragIcon = LoadPicture()
  ElseIf Figura = Pedone_Bianco Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "bianco.pedone.ico")
  ElseIf Figura = Cavallo_Bianco Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "bianco.cavallo.ico")
  ElseIf Figura = Alfiere_Bianco Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "bianco.alfiere.ico")
  ElseIf Figura = Torre_Bianco Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "bianco.torre.ico")
  ElseIf Figura = Dama_Bianco Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "bianco.dama.ico")
  ElseIf Figura = Re_Bianco Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "bianco.re.ico")
  ElseIf Figura = Pedone_Nero Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "nero.pedone.ico")
  ElseIf Figura = Cavallo_Nero Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "nero.cavallo.ico")
  ElseIf Figura = Alfiere_Nero Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "nero.alfiere.ico")
  ElseIf Figura = Torre_Nero Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "nero.torre.ico")
  ElseIf Figura = Dama_Nero Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "nero.dama.ico")
  ElseIf Figura = Re_Nero Then
      Casa(IdxCasa).DragIcon = LoadPicture(PathIcone & "\..\..\DragIcon\Default\" & "nero.re.ico")
  End If
End Sub
Private Sub ImpostaCasaSelezionata(IdxCasa As IndexCasa)
    Dim cs As CoordinateCasa
    If m_CasaSelezionata <> NessunaCasa Then
        Casa(m_CasaSelezionata).Selezionato = False
    End If
    If IdxCasa <> NessunaCasa Then
        Casa(IdxCasa).Selezionato = True
    End If
    cs = SV.IndividuaCoordinateCasa(IdxCasa)
    m_CasaSelezionata = IdxCasa
    m_CasaSelezionataAsseX = cs.x
    m_CasaSelezionataAsseY = cs.Y
    PropertyChanged "CasaSelezionataAsseX"
    PropertyChanged "CasaSelezionataAsseY"
    PropertyChanged "CasaSelezionata"
    PropertyChanged "PezzoNellaCasaSelezionata"
End Sub
Public Function EliminaTraccia(Optional NonConferma As Boolean) As Boolean
Attribute EliminaTraccia.VB_Description = "Cancella la traccia delle mosse effettuate dai pezzi."
  Dim Respose As Integer
  If (m_Quantit‡MosseTraccia <> 0) And (NonConferma <> True) Then
    Respose = MsgBox(Messaggio1, vbYesNo)
    If Respose = 7 Then
      EliminaTraccia = False
      Exit Function
    End If
  End If
  If m_MossaAttuale <> 0 Then
    m_MossaAttuale = 0
    PropertyChanged "MossaAttuale"
    If m_AbilitaVisualizzazionePezzi = True Then
      RaiseEvent CambiatoMossaAttuale(m_MossaAttuale)
    End If
  End If
  m_Quantit‡MosseTraccia = 0
  PropertyChanged "Quantit‡MosseTraccia"
  RaiseEvent CambiatoMossaAttuale(m_MossaAttuale)
  'm_XEnPassant = NessunaColonna
  'PropertyChanged "XEnPassant"
  'm_NeroArroccoPossibile = Nessun_Lato
  'PropertyChanged "NeroArroccoPossibile"
  'm_BiancoArroccoPossibile = Nessun_Lato
  'PropertyChanged "BiancoArroccoPossibile"
  ReDim m_Traccia(m_Quantit‡MosseTraccia)
  m_Traccia(m_Quantit‡MosseTraccia).BiancoArroccoPossibile = m_BiancoArroccoPossibile
  m_Traccia(m_Quantit‡MosseTraccia).NeroArroccoPossibile = m_NeroArroccoPossibile
  m_Traccia(m_Quantit‡MosseTraccia).XEnPassant = NessunaColonna
  PropertyChanged "Traccia"
  EliminaTraccia = True
End Function
Public Sub PosizioneIniziale(Optional NonConferma As Boolean)
Attribute PosizioneIniziale.VB_Description = "Dispone i pezzi nella scacchiera secondo la posizione di inizio gioco."
    Dim TmpValue As Boolean
    TmpValue = AbilitaVisualizzazionePezzi
    AbilitaVisualizzazionePezzi = False
    If EliminaTraccia(NonConferma) = False Then
      Exit Sub
    End If
    m_NeroArroccoPossibile = Entrambi
    m_BiancoArroccoPossibile = Entrambi
    m_Traccia(m_Quantit‡MosseTraccia).BiancoArroccoPossibile = m_BiancoArroccoPossibile
    m_Traccia(m_Quantit‡MosseTraccia).NeroArroccoPossibile = m_NeroArroccoPossibile
    m_Traccia(m_Quantit‡MosseTraccia).XEnPassant = NessunaColonna
    Dim idx As Integer
    For idx = 16 To 47
        Casa(idx).Figura = Nessun_Pezzo
    Next idx
    Casa(0).Figura = Torre_Bianco
    Casa(1).Figura = Cavallo_Bianco
    Casa(2).Figura = Alfiere_Bianco
    Casa(3).Figura = Dama_Bianco
    Casa(4).Figura = Re_Bianco
    Casa(5).Figura = Alfiere_Bianco
    Casa(6).Figura = Cavallo_Bianco
    Casa(7).Figura = Torre_Bianco
    For idx = 8 To 15
        Casa(idx).Figura = Pedone_Bianco
    Next idx
    Casa(56).Figura = Torre_Nero
    Casa(57).Figura = Cavallo_Nero
    Casa(58).Figura = Alfiere_Nero
    Casa(59).Figura = Dama_Nero
    Casa(60).Figura = Re_Nero
    Casa(61).Figura = Alfiere_Nero
    Casa(62).Figura = Cavallo_Nero
    Casa(63).Figura = Torre_Nero
    For idx = 48 To 55
        Casa(idx).Figura = Pedone_Nero
    Next idx
    AbilitaVisualizzazionePezzi = TmpValue
End Sub
Public Sub SvuotaScacchiera(Optional NonConfermaEliminaTraccia As Boolean)
Attribute SvuotaScacchiera.VB_Description = "Toglie tutti i pezzi dalla scacchiera."
  Dim TmpValue As Boolean
  TmpValue = AbilitaVisualizzazionePezzi
  AbilitaVisualizzazionePezzi = False
  If EliminaTraccia(NonConfermaEliminaTraccia) = False Then
    Exit Sub
  End If
  Dim m_def_DisposizioneScacchiera(0 To 7, 0 To 7) As pezzo
  m_DisposizioneScacchiera = m_def_DisposizioneScacchiera
  AggiornaDisposizionePezzi
  DisponiScacchiera
  m_BiancoArroccoPossibile = Nessun_Lato
  m_NeroArroccoPossibile = Nessun_Lato
  m_XEnPassant = NessunaColonna
  AbilitaVisualizzazionePezzi = TmpValue
End Sub
Private Sub AggiornaDisposizionePezzi()
  Dim N As Integer
  Dim m_def_DisposizionePezzi(Nero To Bianco, 1 To 64) As CollocazionePezzo
  If AbilitaVisualizzazionePezzi = True Then
    m_DisposizionePezzi = m_def_DisposizionePezzi
    m_Quantit‡PezziNeri = 0: m_Quantit‡PezziBianchi = 0
    For N = A1 To H8
      Dim pezzo As pezzo
      pezzo = Casa(N).Figura
      'se il pezzo Ë bianco
      If pezzo >= 0 Then
        m_Quantit‡PezziBianchi = m_Quantit‡PezziBianchi + 1
        m_DisposizionePezzi(Bianco, m_Quantit‡PezziBianchi).pezzo = pezzo
        m_DisposizionePezzi(Bianco, m_Quantit‡PezziBianchi).Posizione.x = SV.IndividuaXCasa(N)
        m_DisposizionePezzi(Bianco, m_Quantit‡PezziBianchi).Posizione.Y = SV.IndividuaYCasa(N)
      'se il pezzo Ë nero
      Else
        m_Quantit‡PezziNeri = m_Quantit‡PezziNeri + 1
        m_DisposizionePezzi(Nero, m_Quantit‡PezziNeri).pezzo = pezzo
        m_DisposizionePezzi(Nero, m_Quantit‡PezziNeri).Posizione.x = SV.IndividuaXCasa(N)
        m_DisposizionePezzi(Nero, m_Quantit‡PezziNeri).Posizione.Y = SV.IndividuaYCasa(N)
      End If
    Next
    m_Quantit‡Pezzi = m_Quantit‡PezziNeri + m_Quantit‡PezziBianchi
    PropertyChanged "DisposizionePezzi"
  End If
End Sub
Private Sub AggiornaDisposizioneScacchiera()
  Dim m_def_DisposizioneScacchiera(0 To 7, 0 To 7) As pezzo
  m_DisposizioneScacchiera = m_def_DisposizioneScacchiera
  Dim N As Integer
  If m_Quantit‡PezziBianchi <> 0 Then
    For N = 1 To m_Quantit‡PezziBianchi
      m_DisposizioneScacchiera(m_DisposizionePezzi(Bianco, N).Posizione.x, m_DisposizionePezzi(Bianco, N).Posizione.Y) = m_DisposizionePezzi(Bianco, N).pezzo
    Next
  End If
  If m_Quantit‡PezziNeri <> 0 Then
    For N = 1 To m_Quantit‡PezziNeri
      m_DisposizioneScacchiera(m_DisposizionePezzi(Nero, N).Posizione.x, m_DisposizionePezzi(Nero, N).Posizione.Y) = m_DisposizionePezzi(Nero, N).pezzo
    Next
  End If
  PropertyChanged "DisposizionePezzi"
End Sub
Public Sub SaveToFile(File As String)
Attribute SaveToFile.VB_Description = "Salva su file la situazione della scacchiera."
  Dim NumeroFile As Integer
  Dim st As String
  NumeroFile = FreeFile
  Open File For Output As #NumeroFile
    Dim VariabileTag As String
    VariabileTag = Tag
    Write #NumeroFile, VariabileTag
    st = Sostituisci(m_Evento, Chr(13), Chr(182))
    st = Sostituisci(st, Chr(10), Chr(183))
    Write #NumeroFile, st
    Write #NumeroFile, m_EventoLuogo
    Write #NumeroFile, m_EventoData
    Write #NumeroFile, m_EventoOra
    Write #NumeroFile, m_EventoSponsor
    Write #NumeroFile, m_EventoTipoGara
    Write #NumeroFile, m_EventoSessione
    Write #NumeroFile, m_EventoTurno
    Write #NumeroFile, m_EventoNumeroScacchiera
    Write #NumeroFile, m_EventoIncontro
    Write #NumeroFile, m_EventoRisultato
    Write #NumeroFile, m_EventoApertura
    Write #NumeroFile, m_EventoSottoApertura
    Write #NumeroFile, m_EventoSottoSottoApertura
    Write #NumeroFile, m_EventoECO
    Write #NumeroFile, m_EventoNIC
    Write #NumeroFile, m_EventoTerminato
    Write #NumeroFile, m_EventoNomeAnnotatore
    Write #NumeroFile, m_EventoModo
    Write #NumeroFile, m_EventoExtra
    Write #NumeroFile, m_BiancoGiocatore
    Write #NumeroFile, m_NeroGiocatore
    Write #NumeroFile, m_BiancoElo
    Write #NumeroFile, m_NeroElo
    Write #NumeroFile, m_BiancoUSCF
    Write #NumeroFile, m_NeroUSCF
    Write #NumeroFile, m_BiancoTitolo
    Write #NumeroFile, m_NeroTitolo
    Write #NumeroFile, m_BiancoEm
    Write #NumeroFile, m_NeroEm
    Write #NumeroFile, m_BiancoTipoGiocatore
    Write #NumeroFile, m_NeroTipoGiocatore
    Write #NumeroFile, m_BiancoNazionalit‡
    Write #NumeroFile, m_NeroNazionalit‡
    Write #NumeroFile, m_CasaSelezionata
    Write #NumeroFile, m_CasaSelezionataAsseX
    Write #NumeroFile, m_CasaSelezionataAsseY
    Write #NumeroFile, m_Orientamento
    Write #NumeroFile, m_Editabilit‡
    Write #NumeroFile, m_VisualizzaCoordinate
    Write #NumeroFile, m_RegistraTempo
    Dim x As Colonna, Y As Riga
    For x = Colonna_A To Colonna_H
      For Y = Riga_1 To Riga_8
        Write #NumeroFile, m_DisposizioneScacchiera(x, Y)
      Next
    Next
    Write #NumeroFile, m_Quantit‡MosseTraccia
    ReDim Preserve m_Traccia(m_Quantit‡MosseTraccia)
    Dim N As Integer
    For N = 0 To m_Quantit‡MosseTraccia
      Write #NumeroFile, m_Traccia(N).Provenienza.pezzo
      Write #NumeroFile, m_Traccia(N).Provenienza.Posizione.x
      Write #NumeroFile, m_Traccia(N).Provenienza.Posizione.Y
      Write #NumeroFile, m_Traccia(N).Destinazione.pezzo
      Write #NumeroFile, m_Traccia(N).Destinazione.Posizione.x
      Write #NumeroFile, m_Traccia(N).Destinazione.Posizione.Y
      Write #NumeroFile, m_Traccia(N).Promozione
      Write #NumeroFile, m_Traccia(N).BiancoArroccoPossibile
      Write #NumeroFile, m_Traccia(N).NeroArroccoPossibile
      Write #NumeroFile, m_Traccia(N).XEnPassant
      Write #NumeroFile, m_Traccia(N).Editabilit‡
      st = Sostituisci(m_Traccia(N).Nota, Chr(13), Chr(182))
      st = Sostituisci(st, Chr(10), Chr(183))
      Write #NumeroFile, st
      Write #NumeroFile, m_Traccia(N).Collegamento
      Write #NumeroFile, m_Traccia(N).Tempo
    Next
    Write #NumeroFile, CInt(m_MossaAttuale)
    Write #NumeroFile, CInt(m_XEnPassant)
    Write #NumeroFile, CInt(m_NeroArroccoPossibile)
    Write #NumeroFile, CInt(m_BiancoArroccoPossibile)
  Close #NumeroFile
End Sub
Public Sub ReadToFile(File As String)
Attribute ReadToFile.VB_Description = "Carica da file una impostazione della scacchiera."
  Dim NumeroFile As Integer
  If LTrim(File) = "" Then
    MsgBox "Non Ë stato specificato nessun nome di file!", vbInformation
  Else
    If Dir(File) <> "" Then
      NumeroFile = FreeFile
      Open File For Input As #NumeroFile
      Dim VariabileTag As String
      Input #NumeroFile, VariabileTag
      Tag = VariabileTag
      Input #NumeroFile, m_Evento
      m_Evento = Sostituisci(m_Evento, Chr(182), Chr(13))
      m_Evento = Sostituisci(m_Evento, Chr(183), Chr(10))
      Input #NumeroFile, m_EventoLuogo
      Input #NumeroFile, m_EventoData
      Input #NumeroFile, m_EventoOra
      Input #NumeroFile, m_EventoSponsor
      Input #NumeroFile, m_EventoTipoGara
      Input #NumeroFile, m_EventoSessione
      Input #NumeroFile, m_EventoTurno
      Input #NumeroFile, m_EventoNumeroScacchiera
      Input #NumeroFile, m_EventoIncontro
      Input #NumeroFile, m_EventoRisultato
      Input #NumeroFile, m_EventoApertura
      Input #NumeroFile, m_EventoSottoApertura
      Input #NumeroFile, m_EventoSottoSottoApertura
      Input #NumeroFile, m_EventoECO
      Input #NumeroFile, m_EventoNIC
      Input #NumeroFile, m_EventoTerminato
      Input #NumeroFile, m_EventoNomeAnnotatore
      Input #NumeroFile, m_EventoModo
      Input #NumeroFile, m_EventoExtra
      Input #NumeroFile, m_BiancoGiocatore
      Input #NumeroFile, m_NeroGiocatore
      Input #NumeroFile, m_BiancoElo
      Input #NumeroFile, m_NeroElo
      Input #NumeroFile, m_BiancoUSCF
      Input #NumeroFile, m_NeroUSCF
      Input #NumeroFile, m_BiancoTitolo
      Input #NumeroFile, m_NeroTitolo
      Input #NumeroFile, m_BiancoEm
      Input #NumeroFile, m_NeroEm
      Input #NumeroFile, m_BiancoTipoGiocatore
      Input #NumeroFile, m_NeroTipoGiocatore
      Input #NumeroFile, m_BiancoNazionalit‡
      Input #NumeroFile, m_NeroNazionalit‡
      Input #NumeroFile, m_CasaSelezionata
      Input #NumeroFile, m_CasaSelezionataAsseX
      Input #NumeroFile, m_CasaSelezionataAsseY
      Input #NumeroFile, m_Orientamento
      Input #NumeroFile, m_Editabilit‡
      Input #NumeroFile, m_VisualizzaCoordinate
      Input #NumeroFile, m_RegistraTempo
      Dim x As Colonna, Y As Riga
      For x = Colonna_A To Colonna_H
        For Y = Riga_1 To Riga_8
          Dim INTE As Integer
          Input #NumeroFile, INTE
          m_DisposizioneScacchiera(x, Y) = INTE
          Casa(SV.IndividuaIndexCasa(x, Y)).Figura = m_DisposizioneScacchiera(x, Y)
        Next
      Next
      AggiornaDisposizionePezzi
      Input #NumeroFile, m_Quantit‡MosseTraccia
      ReDim Preserve m_Traccia(m_Quantit‡MosseTraccia)
      Dim N As Integer
      For N = 0 To m_Quantit‡MosseTraccia
        Input #NumeroFile, m_Traccia(N).Provenienza.pezzo
        Input #NumeroFile, m_Traccia(N).Provenienza.Posizione.x
        Input #NumeroFile, m_Traccia(N).Provenienza.Posizione.Y
        Input #NumeroFile, m_Traccia(N).Destinazione.pezzo
        Input #NumeroFile, m_Traccia(N).Destinazione.Posizione.x
        Input #NumeroFile, m_Traccia(N).Destinazione.Posizione.Y
        Input #NumeroFile, m_Traccia(N).Promozione
        Input #NumeroFile, m_Traccia(N).BiancoArroccoPossibile
        Input #NumeroFile, m_Traccia(N).NeroArroccoPossibile
        Input #NumeroFile, m_Traccia(N).XEnPassant
        Input #NumeroFile, m_Traccia(N).Editabilit‡
        Input #NumeroFile, m_Traccia(N).Nota
        m_Traccia(N).Nota = Sostituisci(m_Traccia(N).Nota, Chr(182), Chr(13))
        m_Traccia(N).Nota = Sostituisci(m_Traccia(N).Nota, Chr(183), Chr(10))
        Input #NumeroFile, m_Traccia(N).Collegamento
        Input #NumeroFile, m_Traccia(N).Tempo
      Next
      Input #NumeroFile, m_MossaAttuale
      Input #NumeroFile, m_XEnPassant
      Input #NumeroFile, m_NeroArroccoPossibile
      Input #NumeroFile, m_BiancoArroccoPossibile
      Aggiorna
      Close #NumeroFile
      RaiseEvent PezzoPosizionato(Empty, Empty, Empty)
    Else
      MsgBox "Il file '" + File + "' non esiste!", vbInformation
    End If
  End If
End Sub
Public Sub DeselezionaTutto()
Attribute DeselezionaTutto.VB_Description = "Deseleziona tutte le case della scacchiera."
  Dim obj As Object
  If m_AbilitaVisualizzazionePezzi = True Then
    For Each obj In Casa
      obj.Selezionato = False
    Next
  End If
  SelezionatoProvenienza = NessunaCasa
  SelezionatoDestinazione = NessunaCasa
End Sub
Public Sub InserisciPezzo(pezzo As pezzo)
Attribute InserisciPezzo.VB_Description = "Inserisci un pezzo nella scacchirera, il pezzo verr‡ inserito nelle case selezionate se esistenti, altrimenti verr‡ posizionato in una casa vuota."
  Dim FL
  Dim C As Object
  Dim Respose As Variant
  If Editabilit‡ <> Editabile Then
    Respose = MsgBox("Attualmente la scacchiera non Ë editabile! Occorre impostarla come tale.", vbRetryCancel)
    If Respose = 4 Then
      Editabilit‡ = Editabile
      MsgBox "Il problema Ë stato risolto automaticamente!", vbInformation
    End If
  End If
  If Editabilit‡ = Editabile Then
    For Each C In Casa
      If C.Selezionato = True Then
        C.Figura = pezzo
        FL = True
      End If
    Next
    DeselezionaTutto
    If FL = False Then
      For Each C In Casa
        If C.Figura = Nessun_Pezzo Then
          C.Figura = pezzo
          Exit For
        End If
      Next
    End If
  End If
End Sub
Public Function PosizioneReBianco() As CoordinateCasa
  PosizioneReBianco = Elaborazione.PosizioneRe(Bianco, DisposizioneScacchiera)
End Function
Public Function PosizioneReNero() As CoordinateCasa
  PosizioneReNero = Elaborazione.PosizioneRe(Nero, DisposizioneScacchiera)
End Function

Function FigureScacchi() As Object
   On Local Error Resume Next
   Set FigureScacchi = Extender.Container.FigureScacchi
End Function
Public Sub RicaricaFigure()
Attribute RicaricaFigure.VB_Description = "Questo metodo aggiorna la scacchiera quando viene cambiato il set delle figure utilizzato."
  Dim N As IndexCasa
  Dim p As pezzo
  For N = 0 To 63
    p = Casa(N).Figura
    Casa(N).Figura = Nessun_Pezzo
    Casa(N).Figura = p
  Next
End Sub
Public Sub ImpostaPezzoPromosso(pezzo As Genere)
  Dim x As Colonna
  Dim Y As Riga
  Dim pz As pezzo
  m_Traccia(m_MossaAttuale).Promozione = pezzo
  For x = Colonna_A To Colonna_H
    If m_DisposizioneScacchiera(x, Riga_1) = Pedone_Nero Then
      pz = -pezzo
      'm_DisposizioneScacchiera(x, Riga_1) = PZ
      'AggiornaDisposizionePezzi
      Casa(SV.IndividuaIndexCasa(x, Riga_1)).Figura = pz
      Exit Sub
    End If
  Next
  For x = Colonna_A To Colonna_H
    If m_DisposizioneScacchiera(x, Riga_8) = Pedone_Bianco Then
      pz = pezzo
      'm_DisposizioneScacchiera(x, riga_8) = PZ
      'AggiornaDisposizionePezzi
      Casa(SV.IndividuaIndexCasa(x, Riga_8)).Figura = pz
      Exit Sub
    End If
  Next
End Sub
Public Sub EffettuaMossa(Mossa As Variant, Optional Commento As String)
  Muovi SV.IndividuaIndexCasa(Mossa.Provenienza.x, Mossa.Provenienza.Y), SV.IndividuaIndexCasa(Mossa.Destinazione.x, Mossa.Destinazione.Y), Mossa.Promosso, Commento
End Sub
Public Function ScaccoMatto() As Boolean
  Dim Mosse() As Variant
  Dim QP As Integer
  Dim QM As Integer
  If Editabilit‡ = BiancoMossePossibili Or Editabilit‡ = NeroMossePossibili Then
    QM = Elaborazione.TutteLeMossePossibili(m_Editabilit‡, m_DisposizioneScacchiera, Mosse, QP, m_XEnPassant, m_BiancoArroccoPossibile, m_NeroArroccoPossibile, Elaborazione.PosizioneRe(Bianco, m_DisposizioneScacchiera), Elaborazione.PosizioneRe(Nero, m_DisposizioneScacchiera), Scacco(m_Editabilit‡))
    If QM = 0 And QP <> 0 Then
      ScaccoMatto = True
    End If
  End If
End Function

Private Function Sostituisci(Stringa As String, carattere As String, sostituto As String) As String
  Dim NS As String
  Dim N As Integer
  If Len(Stringa) <> 0 Then
    For N = 1 To Len(Stringa)
      Dim C As String
      C = Mid(Stringa, N, 1)
      If C = carattere Then
        C = sostituto
      End If
      NS = NS + C
    Next
  End If
  Sostituisci = NS
End Function

Public Property Get PezzoNellaScacchiera(IndexCasa As IndexCasa) As pezzo
Attribute PezzoNellaScacchiera.VB_ProcData.VB_Invoke_Property = ";Situazione"
    PezzoNellaScacchiera = Casa(IndexCasa).Figura
End Property
Public Property Let PezzoNellaScacchiera(IndexCasa As IndexCasa, New_Pezzo As pezzo)
    Casa(IndexCasa).Figura = New_Pezzo
End Property

Private Sub ColoraScacchiera()
    Dim C As Integer
    Dim FL As Boolean
    FL = True
    For C = 0 To 63
      If (C Mod 8) = 0 Then
        FL = Not FL
      End If
      If FL = True Then
        If (C Mod 2) = 0 Then
          Casa(C).ColoreCasa = Bianco
        Else
          Casa(C).ColoreCasa = Nero
        End If
      Else
        If (C Mod 2) = 0 Then
          Casa(C).ColoreCasa = Nero
        Else
          Casa(C).ColoreCasa = Bianco
        End If
      End If
    Next
End Sub
