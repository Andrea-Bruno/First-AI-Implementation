Private Sub UserControl_InitProperties()
    m_CasaSelezionataAsseY = m_def_CasaSelezionataAsseY
    m_CasaSelezionata = m_def_CasaSelezionata
    m_Orientamento = m_def_Orientamento
    m_Editabilit‡ = m_def_Editabilit‡
    m_VisualizzaCoordinate = m_def_VisualizzaCoordinate
    m_CasaSelezionataAsseX = m_def_CasaSelezionataAsseX
    m_XEnPassant = m_def_XEnPassant
    m_NeroArroccoPossibile = m_def_NeroArroccoPossibile
    m_BiancoArroccoPossibile = m_def_BiancoArroccoPossibile
    m_TipoDiSelezione = m_def_TipoDiSelezione
    m_AbilitaVisualizzazionePezzi = m_def_AbilitaVisualizzazionePezzi
    m_RegistraTempo = m_def_RegistraTempo
    m_MossaAttuale = m_def_MossaAttuale
    RaiseEvent CambiatoMossaAttuale(m_MossaAttuale)
    m_Quantit‡MosseTraccia = m_def_Quantit‡MosseTraccia
    Dim m_def_DisposizioneScacchiera(0 To 7, 0 To 7) As pezzo
    m_DisposizioneScacchiera = m_def_DisposizioneScacchiera
    Dim m_def_DisposizionePezzi(Nero To Bianco, 1 To 64) As CollocazionePezzo
    m_DisposizionePezzi = m_def_DisposizionePezzi
    ReDim m_Traccia(0)
    PosizioneIniziale
End Sub
Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
    UserControl.Enabled = PropBag.ReadProperty("Enabled", True)
    UserControl.BorderStyle = PropBag.ReadProperty("BorderStyle", 0)
    m_CasaSelezionataAsseY = PropBag.ReadProperty("CasaSelezionataAsseY", m_def_CasaSelezionataAsseY)
    m_CasaSelezionata = PropBag.ReadProperty("CasaSelezionata", m_def_CasaSelezionata)
    m_Orientamento = PropBag.ReadProperty("Orientamento", m_def_Orientamento)
    m_Editabilit‡ = PropBag.ReadProperty("Editabilit‡", m_def_Editabilit‡)
    m_CasaSelezionataAsseX = PropBag.ReadProperty("CasaSelezionataAsseX", m_def_CasaSelezionataAsseX)
    m_VisualizzaCoordinate = PropBag.ReadProperty("VisualizzaCoordinate", m_def_VisualizzaCoordinate)
    m_XEnPassant = PropBag.ReadProperty("XEnPassant", m_def_XEnPassant)
    m_BiancoArroccoPossibile = PropBag.ReadProperty("BiancoArroccoPossibile", m_def_BiancoArroccoPossibile)
    m_NeroArroccoPossibile = PropBag.ReadProperty("NeroArroccoPossibile", m_def_NeroArroccoPossibile)
    m_TipoDiSelezione = PropBag.ReadProperty("TipoDiSelezione", m_def_TipoDiSelezione)
    m_Quantit‡MosseTraccia = PropBag.ReadProperty("Quantit‡MosseTraccia", m_def_Quantit‡MosseTraccia)
    m_AbilitaVisualizzazionePezzi = PropBag.ReadProperty("AbilitaVisualizzazionePezzi", m_def_AbilitaVisualizzazionePezzi)
    m_RegistraTempo = PropBag.ReadProperty("RegistraTempo", m_def_RegistraTempo)
    Dim N As Integer
    
    ReDim m_Traccia(m_Quantit‡MosseTraccia)
    For N = 0 To m_Quantit‡MosseTraccia
      Dim S As String
      S = LTrim(Str(N))
      m_Traccia(N).Provenienza.pezzo = PropBag.ReadProperty("ProvenienzaPezzo" + S)
      m_Traccia(N).Provenienza.Posizione.x = PropBag.ReadProperty("ProvenienzaPosizioneX" + S)
      m_Traccia(N).Provenienza.Posizione.Y = PropBag.ReadProperty("ProvenienzaPosizioneY" + S)
      m_Traccia(N).Destinazione.pezzo = PropBag.ReadProperty("DestinazionePezzo" + S)
      m_Traccia(N).Destinazione.Posizione.x = PropBag.ReadProperty("DestinazionePosizioneX" + S)
      m_Traccia(N).Destinazione.Posizione.Y = PropBag.ReadProperty("DestinazionePosizioneY" + S)
      m_Traccia(N).BiancoArroccoPossibile = PropBag.ReadProperty("BiancoArroccoPossibile" + S)
      m_Traccia(N).NeroArroccoPossibile = PropBag.ReadProperty("NeroArroccoPossibile" + S)
      m_Traccia(N).XEnPassant = PropBag.ReadProperty("XEnPassant" + S)
      m_Traccia(N).Editabilit‡ = PropBag.ReadProperty("Editabilit‡" + S)
      m_Traccia(N).Nota = PropBag.ReadProperty("Nota" + S)
      m_Traccia(N).Collegamento = PropBag.ReadProperty("Collegamento" + S)
      m_Traccia(N).Tempo = PropBag.ReadProperty("Tempo" + S)
    Next
  
    m_Evento = PropBag.ReadProperty("Evento")
    m_EventoLuogo = PropBag.ReadProperty("EventoLuogo")
    m_EventoData = PropBag.ReadProperty("EventoData")
    m_EventoOra = PropBag.ReadProperty("EventoOra") 'ora in cui si Ë svolto l'evento
    m_EventoSponsor = PropBag.ReadProperty("EventoSponsor")
    m_EventoTipoGara = PropBag.ReadProperty("EventoTipoGara")
    m_EventoSessione = PropBag.ReadProperty("EventoSessione")
    m_EventoTurno = PropBag.ReadProperty("EventoTurno")
    m_EventoNumeroScacchiera = PropBag.ReadProperty("EventoNumeroScacchiera")
    m_EventoIncontro = PropBag.ReadProperty("EventoIncontro")
    m_EventoRisultato = PropBag.ReadProperty("EventoRisultato")
    m_EventoApertura = PropBag.ReadProperty("EventoApertura")
    m_EventoSottoApertura = PropBag.ReadProperty("EventoSottoApertura")
    m_EventoSottoSottoApertura = PropBag.ReadProperty("EventoSottoSottoApertura")
    m_EventoECO = PropBag.ReadProperty("EventoECO") 'Nome dell'apertura nell'enciclopedia degli scacchi
    m_EventoNIC = PropBag.ReadProperty("EventoNIC") 'codice di apertura nel database
    m_EventoTerminato = PropBag.ReadProperty("EventoTerminato")
    m_EventoNomeAnnotatore = PropBag.ReadProperty("EventonomeAnnotatore")
    m_EventoModo = PropBag.ReadProperty("EventoModo")
    m_EventoExtra = PropBag.ReadProperty("EventoExtra")
    m_BiancoGiocatore = PropBag.ReadProperty("BiancoGiocatore")
    m_NeroGiocatore = PropBag.ReadProperty("NeroGiocatore")
    m_BiancoElo = PropBag.ReadProperty("BiancoElo")
    m_NeroElo = PropBag.ReadProperty("NeroElo")
    m_BiancoUSCF = PropBag.ReadProperty("BiancoUSCF")
    m_NeroUSCF = PropBag.ReadProperty("NeroUSCF")
    m_BiancoTitolo = PropBag.ReadProperty("BiancoTitolo")
    m_NeroTitolo = PropBag.ReadProperty("NeroTitolo")
    m_BiancoEm = PropBag.ReadProperty("BiancoEm") 'indirizzo E-MAIL o Network del bianco
    m_NeroEm = PropBag.ReadProperty("NeroEm") 'indirizzo E-MAIL o Network del nero
    m_BiancoTipoGiocatore = PropBag.ReadProperty("BiancoTipoGiocatore")
    m_NeroTipoGiocatore = PropBag.ReadProperty("NeroTipoGiocatore")
    m_BiancoNazionalit‡ = PropBag.ReadProperty("BiancoNazionalit‡")
    m_NeroNazionalit‡ = PropBag.ReadProperty("NeroNazionalit‡")
    
    
    
    m_MossaAttuale = PropBag.ReadProperty("MossaAttuale", m_MossaAttuale)
    RaiseEvent CambiatoMossaAttuale(m_MossaAttuale)
    Dim m_def_DisposizioneScacchiera(0 To 7, 0 To 7) As pezzo
    m_DisposizioneScacchiera = m_def_DisposizioneScacchiera
    m_Quantit‡Pezzi = PropBag.ReadProperty("Quantit‡Pezzi", 0)
    If m_Quantit‡Pezzi <> 0 Then
      Dim x As Colonna, Y As Riga
      For x = 0 To 7
        For Y = 0 To 7
          m_DisposizioneScacchiera(x, Y) = PropBag.ReadProperty("DisposizioneScacchiera" + SV.AnnotazioneAlgebrica(x, Y))
        Next
      Next
      AggiornaDisposizionePezzi
      DisponiScacchiera
    End If
    Dim idxc As IndexCasa
    For idxc = A1 To H8
      Casa(idxc).TipoDiSelezione = m_TipoDiSelezione
    Next
    SelezionatoProvenienza = NessunaCasa
    SelezionatoDestinazione = NessunaCasa
    Aggiorna
End Sub
Private Sub DisponiScacchiera()
    'Questa precedira dispone i pezzi nella scacchiera basandosi sul contemuto della matrice
    'm_DisposiszioneScacchiera la quale definisce che pezzi vi sono nella scacchiera
    Dim x As Colonna, Y As Riga
    For x = 0 To 7
      For Y = 0 To 7
        If Casa(SV.IndividuaIndexCasa(x, Y)).Figura <> m_DisposizioneScacchiera(x, Y) Then
          Casa(SV.IndividuaIndexCasa(x, Y)).Figura = m_DisposizioneScacchiera(x, Y)
        End If
      Next
    Next
End Sub
Private Sub UserControl_Resize()
    Aggiorna
End Sub

Private Sub UserControl_Terminate()
  Set PS = Nothing
  Set SV = Nothing
End Sub

Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
    Call PropBag.WriteProperty("Enabled", UserControl.Enabled, True)
    Call PropBag.WriteProperty("BorderStyle", UserControl.BorderStyle, 0)
    Call PropBag.WriteProperty("CasaSelezionataAsseY", m_CasaSelezionataAsseY, m_def_CasaSelezionataAsseY)
    Call PropBag.WriteProperty("CasaSelezionata", m_CasaSelezionata, m_def_CasaSelezionata)
    Call PropBag.WriteProperty("Orientamento", m_Orientamento, m_def_Orientamento)
    Call PropBag.WriteProperty("Editabilit‡", m_Editabilit‡, m_def_Editabilit‡)
    Call PropBag.WriteProperty("CasaSelezionataAsseX", m_CasaSelezionataAsseX, m_def_CasaSelezionataAsseX)
    Call PropBag.WriteProperty("VisualizzaCoordinate", m_VisualizzaCoordinate, m_def_VisualizzaCoordinate)
    Call PropBag.WriteProperty("XEnPassant", m_XEnPassant, m_def_XEnPassant)
    Call PropBag.WriteProperty("BiancoArroccoPossibile", m_BiancoArroccoPossibile, m_def_BiancoArroccoPossibile)
    Call PropBag.WriteProperty("NeroArroccoPossibile", m_NeroArroccoPossibile, m_def_NeroArroccoPossibile)
    Call PropBag.WriteProperty("TipoDiSelezione", m_TipoDiSelezione, m_def_TipoDiSelezione)
    Call PropBag.WriteProperty("Quantit‡MosseTraccia", m_Quantit‡MosseTraccia, m_def_Quantit‡MosseTraccia)
    Call PropBag.WriteProperty("AbilitaVisualizzazionePezzi", m_AbilitaVisualizzazionePezzi, m_def_AbilitaVisualizzazionePezzi)
    Call PropBag.WriteProperty("RegistraTempo", m_RegistraTempo, m_def_RegistraTempo)
    Dim N As Integer
    For N = 0 To m_Quantit‡MosseTraccia
      Dim S As String
      S = LTrim(Str(N))
      Call PropBag.WriteProperty("ProvenienzaPezzo" + S, m_Traccia(N).Provenienza.pezzo)
      Call PropBag.WriteProperty("ProvenienzaPosizioneX" + S, m_Traccia(N).Provenienza.Posizione.x)
      Call PropBag.WriteProperty("ProvenienzaPosizioneY" + S, m_Traccia(N).Provenienza.Posizione.Y)
      Call PropBag.WriteProperty("DestinazionePezzo" + S, m_Traccia(N).Destinazione.pezzo)
      Call PropBag.WriteProperty("DestinazionePosizioneX" + S, m_Traccia(N).Destinazione.Posizione.x)
      Call PropBag.WriteProperty("DestinazionePosizioneY" + S, m_Traccia(N).Destinazione.Posizione.Y)
      Call PropBag.WriteProperty("BiancoArroccoPossibile" + S, m_Traccia(N).BiancoArroccoPossibile)
      Call PropBag.WriteProperty("NeroArroccoPossibile" + S, m_Traccia(N).NeroArroccoPossibile)
      Call PropBag.WriteProperty("XEnPassant" + S, m_Traccia(N).XEnPassant)
      Call PropBag.WriteProperty("Editabilit‡" + S, m_Traccia(N).Editabilit‡)
      Call PropBag.WriteProperty("Nota" + S, m_Traccia(N).Nota)
      Call PropBag.WriteProperty("Collegamento" + S, m_Traccia(N).Collegamento)
      Call PropBag.WriteProperty("Tempo" + S, m_Traccia(N).Tempo)
    Next
    Call PropBag.WriteProperty("Evento", m_Evento)
    Call PropBag.WriteProperty("EventoLuogo", m_EventoLuogo)
    Call PropBag.WriteProperty("EventoData", m_EventoData)
    Call PropBag.WriteProperty("EventoOra", m_EventoOra)
    Call PropBag.WriteProperty("EventoSponsor", m_EventoSponsor)
    Call PropBag.WriteProperty("EventoTipoGara", m_EventoTipoGara)
    Call PropBag.WriteProperty("EventoSessione", m_EventoSessione)
    Call PropBag.WriteProperty("EventoTurno", m_EventoTurno)
    Call PropBag.WriteProperty("EventoNumeroScacchiera", m_EventoNumeroScacchiera)
    Call PropBag.WriteProperty("EventoIncontro", m_EventoIncontro)
    Call PropBag.WriteProperty("EventoRisultato", m_EventoRisultato)
    Call PropBag.WriteProperty("EventoApertura", m_EventoApertura)
    Call PropBag.WriteProperty("EventoSottoApertura", m_EventoSottoApertura)
    Call PropBag.WriteProperty("EventoSottoSottoApertura", m_EventoSottoSottoApertura)
    Call PropBag.WriteProperty("EventoECO", m_EventoECO)
    Call PropBag.WriteProperty("EventoNIC", m_EventoNIC)
    Call PropBag.WriteProperty("EventoTerminato", m_EventoTerminato)
    Call PropBag.WriteProperty("EventoNomeAnnotatore", m_EventoNomeAnnotatore)
    Call PropBag.WriteProperty("EventoModo", m_EventoModo)
    Call PropBag.WriteProperty("EventoExtra", m_EventoExtra)
    Call PropBag.WriteProperty("BiancoGiocatore", m_BiancoGiocatore)
    Call PropBag.WriteProperty("NeroGiocatore", m_NeroGiocatore)
    Call PropBag.WriteProperty("BiancoElo", m_BiancoElo)
    Call PropBag.WriteProperty("NeroElo", m_NeroElo)
    Call PropBag.WriteProperty("BiancoUSCF", m_BiancoUSCF)
    Call PropBag.WriteProperty("NeroUSCF", m_NeroUSCF)
    Call PropBag.WriteProperty("BiancoTitolo", m_BiancoTitolo)
    Call PropBag.WriteProperty("NeroTitolo", m_NeroTitolo)
    Call PropBag.WriteProperty("BiancoEm", m_BiancoEm)
    Call PropBag.WriteProperty("NeroEm", m_NeroEm)
    Call PropBag.WriteProperty("BiancoTipoGiocatore", m_BiancoTipoGiocatore)
    Call PropBag.WriteProperty("NeroTipoGiocatore", m_NeroTipoGiocatore)
    Call PropBag.WriteProperty("BiancoNazionalit‡", m_BiancoNazionalit‡)
    Call PropBag.WriteProperty("NeroNazionalit‡", m_NeroNazionalit‡)
    Call PropBag.WriteProperty("MossaAttuale", m_MossaAttuale)
    Call PropBag.WriteProperty("Quantit‡Pezzi", m_Quantit‡Pezzi)
    If m_Quantit‡Pezzi <> 0 Then
      Dim x As Colonna, Y As Riga
      For x = 0 To 7
        For Y = 0 To 7
          Call PropBag.WriteProperty("DisposizioneScacchiera" + SV.AnnotazioneAlgebrica(x, Y), m_DisposizioneScacchiera(x, Y))
        Next
      Next
    End If
End Sub

