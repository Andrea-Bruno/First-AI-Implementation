Attribute VB_Name = "Scacchiera"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
DefInt A-Z
Option Explicit
'Implementazioni classi
Dim PS As New PezziScacchiera
Dim SV As New ScacchieraVirtuale
'Valori predefiniti propriet‡:
Const m_def_CasaSelezionataAsseY = NessunaRiga
Const m_def_CasaSelezionata = NessunaCasa
Const m_def_Orientamento = 0
Const m_def_Editabilit‡ = BiancoMossePossibili
Const m_def_CasaSelezionataAsseX = NessunaColonna
Const m_def_VisualizzaCoordinate = True
Const m_def_XEnPassant = NessunaColonna
Const m_def_NeroArroccoPossibile = Entrambi
Const m_def_BiancoArroccoPossibile = Entrambi
Const m_def_TipoDiSelezione = Bordo
Const m_def_MossaAttuale = 0
Const m_def_Quantit‡MosseTraccia = 0
Const m_def_AbilitaVisualizzazionePezzi = True
Const m_def_RegistraTempo = True
Const Messaggio1 = "Verr‡ persa la traccia delle mosse! Procedi ugualmente?"
Const Messaggio2 = "Non Ë possibile andare oltre!"
Const Messaggio3 = "Il pezzo non Ë stato mosso correttamente!"
Const Messaggio4 = "Si Ë cercato di muovere un pezzo che non puÚ essere spostato!"
Const Messaggio5 = "Nella colonna specificata non esiste nessun pedone nero che puÚ essere catturato en passant"
Const Messaggio6 = "Nella colonna specificata non esiste nessun pedone bianco che puÚ essere catturato en passant"
Const Messaggio7 = "La propriet‡ XEnPassant Ë impostabile solo se viene settata l'Editabilit‡ al valore BianoMossePossibili o NeroMossePossibili"
'Variabili utilizzate per risalire alle caselle selezionbate quando non Ë abilitata la visualizzazione dei pezzi
Private SelezionatoProvenienza As IndexCasa
Private SelezionatoDestinazione As IndexCasa
